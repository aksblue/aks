PHOTO;ENCODING=b:￼
END:VCARD"""
text("${9BEB58D8-868F-4D39-AE76-AFD3459393BB}")
menu(What would you like to do?, [1. Set new anime and start date.    , 2. See anime you’re currently watching , 3. Add completed anime to your watchlist, 4. Add Past Anime, 5. Did I watched this?]) {
case("1. Set new anime and start date.    "):
	runShortcut(name: "Set Started Date Connected To Anime Watch List") >> runShortcut 7
case("2. See anime you’re currently watching "):
	runShortcut(name: "Currently Watching List") >> runShortcut 8
case("3. Add completed anime to your watchlist"):
case("4. Add Past Anime"):
case("5. Did I watched this?"):
} >> MenuResult 1
if(Menu Result ==) {
var 0A0C9F74-D868-419F-BA2A-C1AC3E5583F9 = """title: Set New Anime and Start Date
