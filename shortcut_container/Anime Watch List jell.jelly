var 8E624D7D-9F05-45D8-872A-BBD811F86CE8 = """BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Set New Anime and Start Date;;;;
ORG: Add a new anime to track and set its start date;
URL;CHARSET=utf-8:;
TITLE;CHARSET=utf-8:;
NICKNAME;CHARSET=utf-8:;
PHOTO;ENCODING=b;TYPE=PNG:￼
END:VCARD

BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:See Anime You’re Currently Watching;;;;
ORG:View your ongoing watchlist;
PHOTO;ENCODING=b:￼
END:VCARD

BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Add Completed Anime to Your Watchlist;;;;
ORG:Mark completed anime as watched;
PHOTO;ENCODING=b:￼
END:VCARD

BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Add Past Anime to Your Watched List;;;;
ORG:Log anime you’ve watched in the past;
PHOTO;ENCODING=b:￼
END:VCARD

BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Did I Watch This?;;;;
ORG:Check if an anime is already in your watch history;
PHOTO;ENCODING=b:￼
END:VCARD

BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Edit;;;;
ORG:Modify or update your saved anime list, set started date;
PHOTO;ENCODING=b:￼
END:VCARD
BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Exit;;;;
ORG:;
URL;CHARSET=utf-8:;
TITLE;CHARSET=utf-8:;
NICKNAME;CHARSET=utf-8:;
PHOTO;ENCODING=b:￼
END:VCARD"""
text("${8E624D7D-9F05-45D8-872A-BBD811F86CE8}")
var mainMenu = Text
setName(input: mainMenu, name: "Menu.vcf") >> setName
choose(list: Renamed Item, prompt: "Which one?") >> choose
if(Selected Item == "Set New Anime and Start Date") {
	runShortcut(name: "Set Started Date Connected To Anime Watch List", input: Selected Item) >> runShortcut
	exit()
} >> IFResult 1
if(Selected Item == "See Anime You’re Currently Watching") {
	runShortcut(name: "Currently Watching List") >> runShortcut 1
	exit()
} >> IFResult 2
if(Selected Item == "Add Completed Anime to Your Watchlist") {
	runShortcut(name: "Anime Watch List (csv) 1") >> runShortcut 2
	exit()
} >> IFResult 3
if(Selected Item == "Add Past Anime to Your Watched List") {
	runShortcut(name: "Add pass anime", input: ShortcutInput) >> runShortcut 3
	exit()
} >> IFResult 4
if(Selected Item == "Did I Watch This?") {
	runShortcut(name: "Did I Watched This?", input: ShortcutInput) >> runShortcut 4
	exit()
} >> IFResult 5
if(Selected Item == "Edit") {
	menu(Select one to edit., [Your Anime Watch List, Set Starting Date]) {
	case("Your Anime Watch List"):
		runShortcut(name: "Edit Anime List") >> runShortcut 5
	case("Set Starting Date"):
		runShortcut(name: "Edit “Set Started Date”") >> runShortcut 6
	} >> MenuResult
	exit()
} >> IFResult 6
if(Selected Item == "Exit") {
	exit()
} >> IFResult 7
// Finished! Below action’s is the old menu that was used 
exit()
var 9BEB58D8-868F-4D39-AE76-AFD3459393BB = """BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Import Into Jellycuts;;;;
ORG: Import an existing shortcut into Jellycuts;
