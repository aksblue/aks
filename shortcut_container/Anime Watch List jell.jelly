TITLE;CHARSET=utf-8:;
NICKNAME;CHARSET=utf-8:;
PHOTO;ENCODING=b:￼
END:VCARD
BEGIN:VCARD
VERSION:3.0
N;CHARSET=utf-8:Import Objects Into Jellycuts;;;;
ORG: Import all objects from a shortcut into Jellycuts;
